<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Partilha de dados com os widgets (Fase 7). Sem HealthKit (evita problemas com o perfil gratuito do sideload). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.lifereset.app</string>
	</array>
</dict>
</plist>
